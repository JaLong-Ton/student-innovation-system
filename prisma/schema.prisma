generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime?      @updatedAt
  achievements  Achievement[]
  registrations Registration[]
}

model Achievement {
  id        String   @id @default(cuid())
  userId    String
  title     String
  type      String
  level     String
  date      DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  // --- 性能优化索引 ---
  // 优化学生【个人中心】获取自己成就的速度
  @@index([userId])
  // 优化成就列表按时间排序的速度
  @@index([createdAt])
}

model Competition {
  id                  String         @id @default(cuid())
  name                String
  description         String?
  deadline            DateTime
  category            String
  currentParticipants Int            @default(0)
  maxParticipants     Int
  isActive            Boolean        @default(true)
  registrations       Registration[]

  // --- 性能优化索引 ---
  // 优化前台【竞赛大厅】过滤下架比赛的速度
  @@index([isActive])
  // 优化前台按分类筛选比赛的速度
  @@index([category])
  // 优化前台比赛列表按截止时间排序的速度
  @@index([deadline])
}

model Teacher {
  id            String         @id @default(cuid())
  teacherNo     String         @unique
  name          String
  department    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  registrations Registration[]

  // --- 性能优化索引 ---
  // 优化按教师编号查询的速度
  @@index([teacherNo])
}

model Registration {
  id            String      @id @default(cuid())
  userId        String
  competitionId String
  status        String      @default("PENDING")
  createdAt     DateTime    @default(now())
  applicantName String?
  notes         String?
  projectName   String?
  teacherId     String?
  teamMembers   String?
  feedback      String?
  competition   Competition @relation(fields: [competitionId], references: [id])
  teacher       Teacher?    @relation(fields: [teacherId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  // --- 性能优化索引 ---
  // 优化后台【报名审批】列表的加载速度
  @@index([status])
  // 优化学生【个人中心】获取自己报名记录的速度
  @@index([userId])
  // 优化后台【单个赛事】获取名单及导出的速度
  @@index([competitionId])
  // 优化按时间排序的速度
  @@index([createdAt])
}
