# ===========================================
# Clerk Authentication Configuration
# ===========================================

# 1. 获取 Clerk 密钥:
#    - 访问 https://dashboard.clerk.com
#    - 创建新应用或选择现有应用
#    - 在 "API Keys" 页面找到以下密钥

# Clerk Public Key (客户端使用，可以公开)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk Secret Key (服务端使用，必须保密)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. 配置登录重定向 URL:
#    - 在 Clerk Dashboard 中设置:
#      - Sign-in URL: http://localhost:3000/sign-in
#      - Sign-up URL: http://localhost:3000/sign-up
#      - After sign-in: http://localhost:3000/dashboard
#      - After sign-up: http://localhost:3000/dashboard

# 3. Webhook 配置 (可选，用于用户数据同步)
#    - 在 Clerk Dashboard 中创建 webhook endpoint:
#      - Endpoint URL: https://yourdomain.com/api/webhooks/clerk
#      - Events: user.created, user.updated
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# Database Configuration
# ===========================================

# 选项 1: 使用 Supabase (推荐，免费)
# 1. 访问 https://supabase.com
# 2. 创建新项目
# 3. 在 Settings > Database 获取连接字符串
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# 选项 2: 使用本地 PostgreSQL
# 1. 安装 PostgreSQL
# 2. 创建数据库: createdb student_innovation_db
# 3. 使用以下连接字符串
# DATABASE_URL=postgresql://username:password@localhost:5432/student_innovation_db

# 选项 3: 使用 Prisma 本地数据库 (开发测试)
# DATABASE_URL=file:./dev.db

# ===========================================
# Next.js Configuration
# ===========================================

# 应用 URL (生产环境需要修改)
NEXTAUTH_URL=http://localhost:3000

# Next.js 密钥 (用于加密)
# 生成命令: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-here-at-least-32-characters-long

# ===========================================
# Development Notes
# ===========================================

# 1. 复制此文件为 .env.local:
#    cp .env.example .env.local
#    然后编辑 .env.local 文件，填入真实的密钥

# 2. 永远不要将 .env.local 提交到 Git

# 3. 测试 Clerk 设置:
#    npm run dev
#    访问 http://localhost:3000
#    点击登录/注册按钮测试功能
