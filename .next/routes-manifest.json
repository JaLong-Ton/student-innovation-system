  "dynamicRoutes": [
    {
      "page": "/admin/competitions/[id]/edit",
      "regex": "^/admin/competitions/([^/]+?)/edit(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/admin/competitions/(?<nxtPid>[^/]+?)/edit(?:/)?$"
    },
    {
      "page": "/admin/users/[userId]",
      "regex": "^/admin/users/([^/]+?)(?:/)?$",
